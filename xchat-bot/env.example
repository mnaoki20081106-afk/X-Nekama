# OAuth2 user-context token for the X account running the bot.
XCHAT_BOT_TOKEN=
# Juicebox PIN used to unlock the XChat private keys registered for this account.
XCHAT_PIN=
# X app consumer secret. Required when receiving signed webhooks.
X_CONSUMER_SECRET=
# Optional; resolved from /2/users/me when omitted.
X_BOT_USERNAME=

XCHAT_HOST=127.0.0.1
XCHAT_PORT=3010
XCHAT_WEBHOOK_PATH=/api/webhooks/xchat

# Built-in fallback autoreply. {message} is replaced with the inbound text.
XCHAT_REPLY_TEMPLATE=DMありがとう！「{message}」ってことね。

# Optional: delegate reply generation to your own local/remote generator.
# It receives JSON with the inbound message plus bounded conversation_history,
# guidance, and bot_context, and must return {"reply":"..."}.
XCHAT_REPLY_URL=
XCHAT_REPLY_TOKEN=
XCHAT_REPLY_TIMEOUT_MS=15000

# Short-term per-author conversation memory kept in this process.
# History is bounded and is reset when the process restarts.
XCHAT_HISTORY_MESSAGES=12
XCHAT_MAX_THREADS=500

# Keep signature verification enabled in production.
X_VERIFY_SIGNATURES=true
