# Add these to the server environment. Never commit live values.
ADMIN_PASSWORD=
# Set a stable random secret in production, at least 32 characters.
APP_SECRET=
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data

# Used only when this checkout is the Cloudflare VPN egress gateway.
# Keep the gateway on a host whose outbound traffic is routed through Cloudflare WARP.
X_EGRESS_TOKEN=
X_EGRESS_HOST=127.0.0.1
X_EGRESS_PORT=8788

# Existing host WARP: use warp. Docker Compose configures gluetun automatically.
X_VPN_MODE=warp
