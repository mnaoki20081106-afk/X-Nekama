[Unit]
Description=X-Nekama VPN-only scheduler
After=network-online.target warp-svc.service
Wants=network-online.target warp-svc.service
[Service]
Type=simple
User=xnekama
Group=xnekama
WorkingDirectory=/opt/xnekama
EnvironmentFile=/etc/xnekama.env
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/xnekama-browsers
ExecStartPre=+/usr/sbin/nft -f /etc/xnekama-egress.nft
ExecStart=/usr/bin/node /opt/xnekama/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xnekama
[Install]
WantedBy=multi-user.target
