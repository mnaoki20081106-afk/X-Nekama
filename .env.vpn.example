# Copy to .env. Use values from your VPN provider's WireGuard configuration.
ADMIN_PASSWORD=
APP_SECRET=
PORT=3000
WIREGUARD_ENDPOINT_IP=
WIREGUARD_ENDPOINT_PORT=51820
WIREGUARD_PUBLIC_KEY=
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=
WIREGUARD_PRESHARED_KEY=

# Optional: WARP gateway for a Cloudflare Worker, at least 24 random characters.
X_EGRESS_TOKEN=

# Fixed shared exit (same values on iPhone and Cloudflare).
# For this mode, use your shared WireGuard server, not consumer WARP.
X_EXIT_MODE=warp
X_EXIT_IP=
X_EXIT_COUNTRY=JP
